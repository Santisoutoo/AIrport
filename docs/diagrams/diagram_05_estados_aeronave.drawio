                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="redis-cmd" value="&lt;b&gt;Redis: move_cmd&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;aircraft:{reg}:move_cmd = {&lt;br/&gt;  mode: &quot;waypoints&quot;,&lt;br/&gt;  waypoints: [{lat,lon},...],&lt;br/&gt;  speed_kts: 7.0&lt;br/&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="130" y="535" width="200" height="100" as="geometry"/>
