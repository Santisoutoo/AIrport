                <mxCell id="note-redis-arr" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;dashed=1;fontSize=9;" parent="1" source="gnd-state" target="redis-cmd" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="twr-state" value="&lt;b&gt;TWR — Tower Control&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;b&gt;dep = &quot;TWR&quot;&lt;/b&gt;&lt;br/&gt;Piloto solicita autorización despegue&lt;br/&gt;Agente TWR emite clearance:&lt;br/&gt;• &quot;Cleared for takeoff runway 25R&quot;&lt;br/&gt;Aircraft posicionada en cabecera&lt;br/&gt;(futura: animación despegue)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" parent="1" vertex="1">
