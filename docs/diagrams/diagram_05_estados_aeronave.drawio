                    <mxGeometry x="510" y="290" width="320" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="del-agent-note" value="&lt;b&gt;DEL Agent (Cloud Run)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Input: flight_plan + ATIS + msg&lt;br/&gt;Output: clearance_text + clearance_data&lt;br/&gt;{squawk, initial_alt, SID, runway, QNH}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="900" y="300" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="note-del-arr" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;dashed=1;fontSize=9;" parent="1" source="del-state" target="del-agent-note" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="gnd-state" value="&lt;b&gt;GND — Ground Control&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;b&gt;dep = &quot;GND&quot;&lt;/b&gt;&lt;br/&gt;Piloto solicita pushback y taxi&lt;br/&gt;Agente GND calcula ruta:&lt;br/&gt;• Taxi por taxiways (NetworkX)&lt;br/&gt;• Waypoints en Redis (move_cmd)&lt;br/&gt;X-Plane Plugin anima .obj (10 Hz)&lt;br/&gt;Velocidad: ~7 kt (taxi)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="510" y="500" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="gnd-agent-note" value="&lt;b&gt;GND Agent (Cloud Run)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Input: flight_plan + position + taxi_route + msg&lt;br/&gt;Tools: move_aircraft(), get_taxi_route()&lt;br/&gt;Output: clearance_text (taxi instruction)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="900" y="525" width="260" height="80" as="geometry"/>
