                <mxCell id="lg-c3" value="—— flecha continua: relación estructural (datos derivados)" style="text;html=1;align=left;fontSize=10;spacingLeft=8;" parent="legend" vertex="1">
                    <mxGeometry x="500" y="112" width="470" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="lg-c4" value="-- -- flecha discontinua: flujo de evento (PUB/SUB, callback)" style="text;html=1;align=left;fontSize=10;spacingLeft=8;" parent="legend" vertex="1">
                    <mxGeometry x="500" y="137" width="470" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="lg-c5" value="Color del grupo: dominio funcional al que pertenece la clave" style="text;html=1;align=left;fontSize=10;spacingLeft=8;" parent="legend" vertex="1">
                    <mxGeometry x="500" y="162" width="470" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="lg-note" value="Patrón general: Redis actúa como bus de estado en memoria entre microservicios. Los datos persistentes viven en PostgreSQL; los datos en tiempo real (posición de aeronaves, comandos, eventos, chat) viven en Redis con TTL para auto-limpieza. Los logs de sesión persisten 2 h: tiempo suficiente para hacer debrief post-vuelo sin saturar la memoria." style="text;html=1;align=left;fontSize=10;fontColor=#444;spacingLeft=8;spacingRight=8;spacingTop=4;whiteSpace=wrap;" parent="legend" vertex="1">
                    <mxGeometry x="15" y="200" width="955" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="footer" value="Ficheros fuente que definen estas claves" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#999;fontStyle=1;fontSize=12;" parent="redis-section" vertex="1">
                    <mxGeometry x="1010" y="1190" width="1000" height="300" as="geometry"/>
                </mxCell>
