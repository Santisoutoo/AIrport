                <mxCell id="src-2" value="services/orchestrator_service/&#xa;   config.py                      — conexión&#xa;   session_log.py                 — grupo D&#xa;   api/dispatch.py                — grupos D, E&#xa;   api/events_subscriber.py       — puente B+C+E → D&#xa;   api/aircraft.py                — lector grupo B" style="text;html=1;align=left;fontSize=10;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontFamily=Courier New;" parent="footer" vertex="1">
