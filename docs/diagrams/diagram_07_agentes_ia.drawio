<mxfile host="app.diagrams.net">
  <diagram id="d07-agents" name="07 — Arquitectura de Agentes IA">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TÍTULO -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot;&gt;AIrport — Arquitectura de los Agentes IA (Google ADK + Gemini)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== CAPA LOCAL: ORCHESTRATOR ===== -->
        <mxCell id="layer-local" value="&lt;b&gt;Docker Local — Orchestrator Service :8006&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="1640" height="480" as="geometry"/>
        </mxCell>

        <!-- Input API -->
        <mxCell id="api-input" value="&lt;b&gt;POST /api/v1/dispatch/transmit&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;{message: &quot;N77EM request startup&quot;,&lt;br/&gt; session_id: &quot;sess-001&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;arcSize=8;fontSize=10;" vertex="1" parent="layer-local">
          <mxGeometry x="30" y="60" width="280" height="70" as="geometry"/>
        </mxCell>

        <!-- Orchestrator Agent (ADK) -->
        <mxCell id="orch-agent" value="&lt;b&gt;Orchestrator Agent (Google ADK)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Modelo: Gemini Flash&lt;br/&gt;System Prompt: ATC routing rules&lt;br/&gt;– Identifica callsign y fase actual&lt;br/&gt;– Decide a qué agente reenviar&lt;br/&gt;– Gestiona transiciones de fase&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;arcSize=8;fontSize=10;" vertex="1" parent="layer-local">
          <mxGeometry x="370" y="50" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- Tool: get_known_aircraft -->
        <mxCell id="tool-aircraft" value="&lt;b&gt;Tool: get_known_aircraft()&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;SELECT * FROM aircraft_clearances&lt;br/&gt;WHERE session_id = ?&lt;br/&gt;→ {registration, dependency,&lt;br/&gt;   callsign, aircraft_type}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=8;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="30" y="200" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Tool: forward_to_agent -->
        <mxCell id="tool-forward" value="&lt;b&gt;Tool: forward_to_agent()&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;Param: dependency (DEL/GND/TWR)&lt;br/&gt;Param: registration, message&lt;br/&gt;→ HTTP POST a Cloud Run URL&lt;br/&gt;   correspondiente al agente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=8;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="250" y="200" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Tool: advance_to_gnd -->
        <mxCell id="tool-adv-gnd" value="&lt;b&gt;Tool: advance_to_gnd()&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;UPDATE aircraft_clearances&lt;br/&gt;SET dependency = 'GND'&lt;br/&gt;WHERE registration = ?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=8;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="470" y="200" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Tool: advance_to_twr -->
        <mxCell id="tool-adv-twr" value="&lt;b&gt;Tool: advance_to_twr()&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;UPDATE aircraft_clearances&lt;br/&gt;SET dependency = 'TWR'&lt;br/&gt;WHERE registration = ?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=8;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="690" y="200" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Tool: get_taxi_route -->
        <mxCell id="tool-taxi" value="&lt;b&gt;Tool: get_taxi_route()&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;Params: reg, destination, via=[]&lt;br/&gt;→ taxi_router.compute()&lt;br/&gt;→ NetworkX Dijkstra&lt;br/&gt;→ {waypoints:[{lat,lon},...],&lt;br/&gt;   total_distance_m}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=8;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="910" y="200" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Tool: confirm -->
        <mxCell id="tool-confirm" value="&lt;b&gt;Tool: confirm()&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;Confirmación explícita&lt;br/&gt;de acciones al agente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=8;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="1130" y="200" width="170" height="80" as="geometry"/>
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="pg-local" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;aircraft_clearances&lt;br/&gt;flight_plans&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="1350" y="100" width="140" height="100" as="geometry"/>
        </mxCell>

        <!-- Redis local -->
        <mxCell id="redis-local" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;aircraft:state:{reg}&lt;br/&gt;move_cmd&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="layer-local">
          <mxGeometry x="1350" y="240" width="140" height="100" as="geometry"/>
        </mxCell>

        <!-- Arrows: Agent → Tools -->
        <mxCell id="arr-agent-tools" value="llama herramientas" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;fontSize=9;" edge="1" source="orch-agent" target="tool-aircraft" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-agent-fwd" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="orch-agent" target="tool-forward" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-agent-gnd" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="orch-agent" target="tool-adv-gnd" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-agent-twr" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="orch-agent" target="tool-adv-twr" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-agent-taxi" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="orch-agent" target="tool-taxi" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-tool-pg" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;" edge="1" source="tool-aircraft" target="pg-local" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-tool-adv-pg" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;" edge="1" source="tool-adv-gnd" target="pg-local" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-tool-taxi-redis" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;" edge="1" source="tool-taxi" target="redis-local" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-in-agent" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;" edge="1" source="api-input" target="orch-agent" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Output -->
        <mxCell id="api-output" value="&lt;b&gt;Response:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;{clearance_text: &quot;...&quot;,&lt;br/&gt; clearance_data: {...} | null}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;arcSize=8;fontSize=10;" vertex="1" parent="layer-local">
          <mxGeometry x="30" y="370" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="arr-agent-out" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;" edge="1" source="orch-agent" target="api-output" parent="layer-local"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== CAPA CLOUD RUN ===== -->
        <mxCell id="layer-cloud" value="&lt;b&gt;Google Cloud Run — Agentes Especializados (Stateless)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="1640" height="440" as="geometry"/>
        </mxCell>

        <!-- DEL Agent -->
        <mxCell id="del-agent" value="&lt;b&gt;DEL Agent — Clearance Delivery&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="layer-cloud">
          <mxGeometry x="30" y="40" width="480" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="del-input" value="&lt;b&gt;Input:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;{flight_plan: {reg, type, dest, route,...},&lt;br/&gt; atis: &quot;ATIS Bravo, wind 250/10...&quot;,&lt;br/&gt; controller_message: &quot;...IFR clearance&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="del-agent">
          <mxGeometry x="20" y="50" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="del-model" value="&lt;b&gt;Gemini Flash (Google ADK)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;System Prompt: IFR clearance logic (ICAO)&lt;br/&gt;Genera readback del piloto ICAO-compliant:&lt;br/&gt;&quot;[Callsign], cleared to [dest] via [SID],&lt;br/&gt; squawk [XXXX], climb FL[YYY],&lt;br/&gt; QNH [ZZZZ]&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#7b1fa2;fontSize=9;" vertex="1" parent="del-agent">
          <mxGeometry x="20" y="150" width="440" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="del-output" value="&lt;b&gt;Output:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;{clearance_text: &quot;[readback]&quot;,&lt;br/&gt; clearance_data: {squawk: 2341,&lt;br/&gt;   initial_altitude: 6000, SID: &quot;BCN7W&quot;,&lt;br/&gt;   runway: &quot;25R&quot;, altimeter: 1013}}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="del-agent">
          <mxGeometry x="20" y="280" width="440" height="70" as="geometry"/>
        </mxCell>

        <!-- GND Agent -->
        <mxCell id="gnd-agent" value="&lt;b&gt;GND Agent — Ground Control&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=10;" vertex="1" parent="layer-cloud">
          <mxGeometry x="580" y="40" width="480" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="gnd-input" value="&lt;b&gt;Input:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;{flight_plan, position: {lat,lon,heading},&lt;br/&gt; taxi_route: {waypoints:[...], dist_m: 1200},&lt;br/&gt; controller_message: &quot;...push and start&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;" vertex="1" parent="gnd-agent">
          <mxGeometry x="20" y="50" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gnd-tools" value="&lt;b&gt;Tools disponibles:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• move_aircraft(reg, waypoints, speed)&lt;br/&gt;  → escribe Redis move_cmd&lt;br/&gt;• get_taxi_route(reg, dest, via=[])&lt;br/&gt;  → NetworkX Dijkstra → waypoints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;" vertex="1" parent="gnd-agent">
          <mxGeometry x="20" y="140" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="gnd-model" value="&lt;b&gt;Gemini Flash (Google ADK)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;System Prompt: pushback + taxi logic&lt;br/&gt;&quot;[Callsign], push back approved, face south.&lt;br/&gt; When ready, taxi via Tango-1, Echo-3, holding&lt;br/&gt; short runway 25R&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=9;" vertex="1" parent="gnd-agent">
          <mxGeometry x="20" y="250" width="440" height="80" as="geometry"/>
        </mxCell>

        <!-- TWR Agent -->
        <mxCell id="twr-agent" value="&lt;b&gt;TWR Agent — Tower Control&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=10;" vertex="1" parent="layer-cloud">
          <mxGeometry x="1130" y="40" width="470" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="twr-input" value="&lt;b&gt;Input:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;{flight_plan, position: {lat,lon,heading},&lt;br/&gt; weather: {wind: &quot;250/12&quot;, qnh: 1013},&lt;br/&gt; controller_message: &quot;...cleared for takeoff&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;" vertex="1" parent="twr-agent">
          <mxGeometry x="20" y="50" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="twr-model" value="&lt;b&gt;Gemini Flash (Google ADK)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;System Prompt: takeoff/landing clearance&lt;br/&gt;Sin herramientas de movimiento (stateless)&lt;br/&gt;&quot;[Callsign], runway 25R, cleared for takeoff.&lt;br/&gt; Wind 250 degrees 12 knots&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=9;" vertex="1" parent="twr-agent">
          <mxGeometry x="20" y="150" width="430" height="90" as="geometry"/>
        </mxCell>

        <!-- Conexiones Orchestrator → Cloud Run Agents -->
        <mxCell id="arr-fwd-del" value="HTTPS POST (DEL_AGENT_URL)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;fontSize=9;" edge="1" source="tool-forward" target="del-agent" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-fwd-gnd" value="HTTPS POST (GND_AGENT_URL)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;fontSize=9;" edge="1" source="tool-forward" target="gnd-agent" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-fwd-twr" value="HTTPS POST (TWR_AGENT_URL)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;fontSize=9;" edge="1" source="tool-forward" target="twr-agent" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
