<mxfile host="app.diagrams.net">
  <diagram id="d01-arch-general" name="01 — Arquitectura General del Sistema">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== TÍTULO ===== -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot;&gt;AIrport — Arquitectura General del Sistema&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="700" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== CAPA 1: USUARIO ===== -->
        <mxCell id="layer-user" value="&lt;b&gt;USUARIO&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f9f9f9;strokeColor=#999;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="1640" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="atc-controller" value="&lt;b&gt;Controlador ATC&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666;&quot;&gt;Navegador web&lt;br/&gt;Micrófono&lt;/font&gt;" style="shape=mxgraph.cisco.people.man_person;fillColor=#dae8fc;strokeColor=#6c8ebf;sketch=0;aspect=fixed;" vertex="1" parent="layer-user">
          <mxGeometry x="100" y="30" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="atc-label" value="Controlador ATC" style="text;html=1;align=center;" vertex="1" parent="layer-user">
          <mxGeometry x="75" y="90" width="110" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="xplane-user" value="&lt;b&gt;X-Plane 12&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666;&quot;&gt;Simulador de vuelo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=10;fontSize=11;" vertex="1" parent="layer-user">
          <mxGeometry x="1400" y="30" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== CAPA 2: SERVICIOS LOCALES (DOCKER) ===== -->
        <mxCell id="layer-docker" value="&lt;b&gt;SERVICIOS LOCALES — Docker Compose&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f0f8ff;strokeColor=#4a86e8;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="210" width="1640" height="440" as="geometry"/>
        </mxCell>

        <!-- HMI Service -->
        <mxCell id="hmi-svc" value="&lt;b&gt;Controller HMI Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8005&lt;br/&gt;UI Web + API REST&lt;br/&gt;Flight strips · Radar suelo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="100" y="60" width="190" height="90" as="geometry"/>
        </mxCell>

        <!-- ASR Service -->
        <mxCell id="asr-svc" value="&lt;b&gt;ASR Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8000&lt;br/&gt;Whisper (fine-tuned ATC)&lt;br/&gt;Transcripción voz→texto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="100" y="190" width="190" height="90" as="geometry"/>
        </mxCell>

        <!-- Orchestrator -->
        <mxCell id="orch-svc" value="&lt;b&gt;Orchestrator Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8006&lt;br/&gt;Google ADK Agent&lt;br/&gt;Enrutamiento DEL/GND/TWR&lt;br/&gt;Estado aeronaves&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="420" y="120" width="210" height="110" as="geometry"/>
        </mxCell>

        <!-- Flight Plan Service -->
        <mxCell id="fp-svc" value="&lt;b&gt;Flight Plan Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8003&lt;br/&gt;Generación planes IFR&lt;br/&gt;flightplandatabase.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="420" y="270" width="190" height="90" as="geometry"/>
        </mxCell>

        <!-- Weather Service -->
        <mxCell id="weather-svc" value="&lt;b&gt;Weather Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8004&lt;br/&gt;METAR · TAF · ATIS&lt;br/&gt;Aviation Weather Center&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="650" y="270" width="190" height="90" as="geometry"/>
        </mxCell>

        <!-- Redis -->
        <mxCell id="redis-db" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:6379&lt;br/&gt;Estado en tiempo real&lt;br/&gt;Comandos de movimiento&lt;br/&gt;Pub/Sub&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="980" y="50" width="160" height="110" as="geometry"/>
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="pg-db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:5432&lt;br/&gt;Clearances · Planes de vuelo&lt;br/&gt;ATIS histórico&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="1180" y="50" width="160" height="110" as="geometry"/>
        </mxCell>

        <!-- InfluxDB -->
        <mxCell id="influx-db" value="&lt;b&gt;InfluxDB&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8087&lt;br/&gt;Series temporales&lt;br/&gt;Posición histórica (1 sem)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="1380" y="50" width="160" height="110" as="geometry"/>
        </mxCell>

        <!-- X-Plane Plugin (in Docker layer but external) -->
        <mxCell id="xplane-plugin" value="&lt;b&gt;X-Plane Plugin&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;XPPython3 (in-process)&lt;br/&gt;AircraftSpawner · Tracker&lt;br/&gt;AircraftMover (10 Hz)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=10;fontSize=11;" vertex="1" parent="layer-docker">
          <mxGeometry x="1300" y="250" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== CAPA 3: GOOGLE CLOUD RUN ===== -->
        <mxCell id="layer-cloud" value="&lt;b&gt;GOOGLE CLOUD RUN — Agentes IA&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f3e8ff;strokeColor=#9b59b6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="670" width="1640" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="del-agent" value="&lt;b&gt;DEL Agent&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Clearance Delivery&lt;br/&gt;Gemini Flash&lt;br/&gt;IFR clearance (squawk/SID/QNH)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=11;" vertex="1" parent="layer-cloud">
          <mxGeometry x="300" y="50" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="gnd-agent" value="&lt;b&gt;GND Agent&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Ground Control&lt;br/&gt;Gemini Flash&lt;br/&gt;Pushback · Taxi routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=11;" vertex="1" parent="layer-cloud">
          <mxGeometry x="700" y="50" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="twr-agent" value="&lt;b&gt;TWR Agent&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Tower Control&lt;br/&gt;Gemini Flash&lt;br/&gt;Despegue · Aterrizaje&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=11;" vertex="1" parent="layer-cloud">
          <mxGeometry x="1100" y="50" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== CONEXIONES ===== -->
        <!-- Controller → HMI -->
        <mxCell id="e-ctrl-hmi" value="HTTP / WebAudio" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#555;fontSize=9;" edge="1" source="atc-label" target="hmi-svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HMI → ASR -->
        <mxCell id="e-hmi-asr" value="HTTP POST /transcribe" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="hmi-svc" target="asr-svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HMI → Orchestrator -->
        <mxCell id="e-hmi-orch" value="HTTP POST /dispatch/transmit" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="hmi-svc" target="orch-svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → FP Service -->
        <mxCell id="e-orch-fp" value="HTTP GET /flight-plans" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="orch-svc" target="fp-svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → Weather -->
        <mxCell id="e-orch-weather" value="HTTP GET /weather/atis" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="orch-svc" target="weather-svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → PostgreSQL -->
        <mxCell id="e-orch-pg" value="SQL (clearances)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="orch-svc" target="pg-db" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- X-Plane Plugin ↔ Redis -->
        <mxCell id="e-xp-redis" value="Read/Write (state, move_cmd)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="xplane-plugin" target="redis-db" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- X-Plane Plugin → InfluxDB -->
        <mxCell id="e-xp-influx" value="Write (posición histórica)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="xplane-plugin" target="influx-db" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator ↔ Redis -->
        <mxCell id="e-orch-redis" value="Write (move_cmd, waypoints)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="orch-svc" target="redis-db" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → DEL Agent -->
        <mxCell id="e-orch-del" value="HTTP (Cloud Run)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;fontSize=9;" edge="1" source="orch-svc" target="del-agent" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → GND Agent -->
        <mxCell id="e-orch-gnd" value="HTTP (Cloud Run)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;fontSize=9;" edge="1" source="orch-svc" target="gnd-agent" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → TWR Agent -->
        <mxCell id="e-orch-twr" value="HTTP (Cloud Run)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;fontSize=9;" edge="1" source="orch-svc" target="twr-agent" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HMI → X-Plane Plugin (airport sync) -->
        <mxCell id="e-hmi-xp" value="HTTP (airport ICAO sync)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;fontSize=9;dashed=1;" edge="1" source="hmi-svc" target="xplane-plugin" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
