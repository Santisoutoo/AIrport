<mxfile host="app.diagrams.net">
  <diagram id="d01-arch-general" name="01 — Arquitectura General del Sistema">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TÍTULO -->
        <mxCell id="title" value="AIrport — Arquitectura General del Sistema" style="text;html=0;align=center;fontStyle=1;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="400" y="8" width="900" height="30" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════
             USUARIO
        ══════════════════════════════════════ -->
        <mxCell id="layer-user" value="USUARIO" style="swimlane;startSize=26;fillColor=#f9f9f9;strokeColor=#aaaaaa;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="30" y="44" width="1640" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="atc-controller" value="&lt;b&gt;Controlador ATC&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#555;&quot;&gt;Navegador web · Micrófono&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=11;" parent="layer-user" vertex="1">
          <mxGeometry x="100" y="16" width="175" height="58" as="geometry"/>
        </mxCell>

        <mxCell id="xplane-sim" value="&lt;b&gt;X-Plane 12&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#555;&quot;&gt;Simulador de vuelo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;fontSize=11;" parent="layer-user" vertex="1">
          <mxGeometry x="1360" y="16" width="175" height="58" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════
             DOCKER COMPOSE
             ────────────────────────────────────
             Fila 1: ASR · HMI · Weather · FP
             Fila 2: Orch · PG · Redis · XP Plugin
                                          └→ InfluxDB (debajo de XP)
        ══════════════════════════════════════ -->
        <mxCell id="layer-docker" value="SERVICIOS LOCALES — Docker Compose" style="swimlane;startSize=26;fillColor=#f0f8ff;strokeColor=#4a86e8;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="30" y="152" width="1640" height="565" as="geometry"/>
        </mxCell>

        <!-- ── Fila 1: servicios de entrada ── -->
        <mxCell id="asr-svc" value="&lt;b&gt;ASR Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8006 · Whisper fine-tuned&lt;br/&gt;Transcripción voz → texto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="50" y="55" width="185" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="hmi-svc" value="&lt;b&gt;Controller HMI Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8005 · UI Web + API REST&lt;br/&gt;Flight strips · Radar suelo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="280" y="55" width="200" height="85" as="geometry"/>
        </mxCell>

        <!-- Weather y FP justo a la derecha de HMI, en la misma fila -->
        <mxCell id="weather-svc" value="&lt;b&gt;Weather Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8004 · METAR · ATIS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="560" y="55" width="185" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="fp-svc" value="&lt;b&gt;Flight Plan Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8003 · Planes IFR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="560" y="190" width="185" height="80" as="geometry"/>
        </mxCell>

        <!-- ── Fila 2: orquestador + cadena de datos ── -->
        <mxCell id="orch-svc" value="&lt;b&gt;Orchestrator Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8007 · Google ADK Agent&lt;br/&gt;Enrutamiento DEL / GND / TWR&lt;br/&gt;Pre-fetch · Estado aeronaves&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="260" y="320" width="255" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="pg-db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:5432&lt;br/&gt;Clearances · Planes IFR&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="590" y="320" width="150" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="redis-db" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:6379&lt;br/&gt;Estado · move_cmd&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="810" y="320" width="150" height="105" as="geometry"/>
        </mxCell>

        <!-- X-Plane Plugin alineado verticalmente con X-Plane 12 -->
        <mxCell id="xplane-plugin" value="&lt;b&gt;X-Plane Plugin&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;XPPython3 (in-process)&lt;br/&gt;AircraftSpawner · Tracker&lt;br/&gt;AircraftMover (10 Hz)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=10;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="1340" y="300" width="215" height="105" as="geometry"/>
        </mxCell>

        <!-- InfluxDB debajo de X-Plane Plugin (misma columna) -->
        <mxCell id="influx-db" value="&lt;b&gt;InfluxDB&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;:8087 · Series temporales&lt;br/&gt;Posición histórica (1 sem)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="layer-docker" vertex="1">
          <mxGeometry x="1355" y="455" width="150" height="105" as="geometry"/>
        </mxCell>

        <!-- ══════ FLECHAS dentro de Docker ══════ -->

        <!-- HMI ↔ ASR  (bidireccional, misma fila) -->
        <mxCell id="e-hmi-asr" value="transcribe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;startArrow=block;startFill=0;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="hmi-svc" target="asr-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HMI → Weather  (dashed, misma fila) -->
        <mxCell id="e-hmi-weather" value="METAR / ATIS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1;fontSize=9;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="hmi-svc" target="weather-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HMI → FlightPlan  (dashed) -->
        <mxCell id="e-hmi-fp" value="planes IFR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1;fontSize=9;dashed=1;endArrow=open;endFill=0;" edge="1" parent="layer-docker" source="hmi-svc" target="fp-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HMI → Orchestrator  (vertical, flujo principal) -->
        <mxCell id="e-hmi-orch" value="POST /dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="hmi-svc" target="orch-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → Weather  (dashed, pre-fetch) -->
        <mxCell id="e-orch-weather" value="ATIS pre-fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=1;fontSize=9;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="orch-svc" target="weather-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → FlightPlan  (dashed, pre-fetch) -->
        <mxCell id="e-orch-fp" value="plan pre-fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=1;fontSize=9;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="orch-svc" target="fp-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator ↔ PostgreSQL  (horizontal) -->
        <mxCell id="e-orch-pg" value="clearances R/W" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;startArrow=block;startFill=0;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="orch-svc" target="pg-db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator ↔ Redis  (horizontal, a través de PG) -->
        <mxCell id="e-orch-redis" value="active_set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;startArrow=block;startFill=0;endArrow=block;endFill=1;" edge="1" parent="layer-docker" source="orch-svc" target="redis-db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Redis ↔ X-Plane Plugin  (horizontal, larga pero clara) -->
        <mxCell id="e-redis-xp" value="move_cmd · posiciones (10 Hz)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=9;startArrow=block;startFill=0;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="redis-db" target="xplane-plugin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- X-Plane Plugin → InfluxDB  (vertical hacia abajo) -->
        <mxCell id="e-xp-influx" value="posición histórica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=1;fontSize=9;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer-docker" source="xplane-plugin" target="influx-db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════
             GOOGLE CLOUD RUN
        ══════════════════════════════════════ -->
        <mxCell id="layer-cloud" value="GOOGLE CLOUD RUN — Agentes IA" style="swimlane;startSize=26;fillColor=#f3e8ff;strokeColor=#9b59b6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="30" y="737" width="1640" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="del-agent" value="&lt;b&gt;DEL Agent — Clearance Delivery&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Gemini Flash · IFR clearance · squawk · SID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=11;" parent="layer-cloud" vertex="1">
          <mxGeometry x="155" y="28" width="290" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="gnd-agent" value="&lt;b&gt;GND Agent — Ground Control&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Gemini Flash · Pushback · Taxi · move_aircraft&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=11;" parent="layer-cloud" vertex="1">
          <mxGeometry x="670" y="28" width="290" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="twr-agent" value="&lt;b&gt;TWR Agent — Tower Control&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Gemini Flash · Despegue · Aterrizaje&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=11;" parent="layer-cloud" vertex="1">
          <mxGeometry x="1185" y="28" width="290" height="78" as="geometry"/>
        </mxCell>

        <!-- ══════ Flechas cruzando capas ══════ -->

        <!-- ATC Controller → HMI -->
        <mxCell id="e-ctrl-hmi" value="HTTP / WebAudio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="atc-controller" target="hmi-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- X-Plane 12 ↔ X-Plane Plugin  (vertical, alineados) -->
        <mxCell id="e-xpsim-plugin" value="XPPython3 in-process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=9;dashed=1;startArrow=block;startFill=0;endArrow=block;endFill=1;" edge="1" parent="1" source="xplane-sim" target="xplane-plugin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → DEL -->
        <mxCell id="e-orch-del" value="HTTP POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="orch-svc" target="del-agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → GND -->
        <mxCell id="e-orch-gnd" value="HTTP POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="orch-svc" target="gnd-agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator → TWR -->
        <mxCell id="e-orch-twr" value="HTTP POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="orch-svc" target="twr-agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
