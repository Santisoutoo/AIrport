                    <mxGeometry x="190" y="165" width="700" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="lg-note" value="SQLAlchemy no declara FOREIGN KEY entre estas tablas: las relaciones se resuelven por valor (matrícula o ICAO). Es una decisión de diseño que permite cargar clearances de prueba sin requerir un flight plan previo y que el Weather Service pueda emitir ATIS de aeropuertos que aún no aparecen en ningún plan de vuelo activo.&#xa;&#xa;La tabla users queda aislada del modelo operacional. Está reservada para autenticación del HMI y se define en SQL puro (init.sql), no por ORM." style="text;html=1;align=left;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=4;whiteSpace=wrap;" parent="legend" vertex="1">
                    <mxGeometry x="20" y="195" width="940" height="75" as="geometry"/>
                </mxCell>
            </root>
