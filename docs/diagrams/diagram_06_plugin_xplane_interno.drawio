<mxfile host="app.diagrams.net">
  <diagram id="d06-plugin" name="06 — Arquitectura Interna Plugin X-Plane">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TÍTULO -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot;&gt;AIrport — Arquitectura Interna del Plugin de X-Plane 12&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="900" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== X-PLANE PROCESS ===== -->
        <mxCell id="xplane-proc" value="&lt;b&gt;X-Plane 12 — Proceso Principal&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="1100" height="960" as="geometry"/>
        </mxCell>

        <!-- XPPython3 Host -->
        <mxCell id="xppython" value="&lt;b&gt;XPPython3 — Python Plugin Host&lt;/b&gt;" style="swimlane;startSize=25;fillColor=#ffe0b2;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="xplane-proc">
          <mxGeometry x="20" y="50" width="1060" height="890" as="geometry"/>
        </mxCell>

        <!-- PI_userInterface.py -->
        <mxCell id="pi-entry" value="&lt;b&gt;PI_userInterface.py&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;Entry Point del Plugin&lt;br/&gt;class PythonInterface:&lt;br/&gt;  XPluginStart() → registra menú&lt;br/&gt;  XPluginEnable() → return 1&lt;br/&gt;  XPluginStop() → cleanup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="xppython">
          <mxGeometry x="380" y="40" width="300" height="100" as="geometry"/>
        </mxCell>

        <!-- Flight Loop 30s -->
        <mxCell id="loop-30s" value="&lt;b&gt;Flight Loop 30s&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;Sync ICAO actual con HMI&lt;br/&gt;AirportService.get_icao()&lt;br/&gt;→ HTTP :8005 /airport/sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="xppython">
          <mxGeometry x="40" y="40" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- WindowManager -->
        <mxCell id="wm" value="&lt;b&gt;WindowManager&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;windows_manager.py&lt;br/&gt;Gestión sesión + componentes&lt;/font&gt;" style="swimlane;startSize=40;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=10;" vertex="1" parent="xppython">
          <mxGeometry x="40" y="160" width="980" height="700" as="geometry"/>
        </mxCell>

        <!-- Flight Loop 2s (polling) -->
        <mxCell id="loop-2s" value="&lt;b&gt;Flight Loop 2s&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;Redis polling:&lt;br/&gt;airport:session_request&lt;br/&gt;→ detecta start/stop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="30" y="60" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- AircraftSpawner -->
        <mxCell id="spawner" value="&lt;b&gt;AircraftSpawner&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;aircraft_spawner.py&lt;br/&gt;spawn(assignments):&lt;br/&gt;• ObjMapper → tipo → .obj path&lt;br/&gt;• xp.loadObject(path)&lt;br/&gt;• probe terrain (elevation)&lt;br/&gt;• xp.createInstance(obj, [])&lt;br/&gt;• xp.instanceSetPosition()&lt;br/&gt;• Registra en registry dict&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="240" y="50" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- AircraftTracker -->
        <mxCell id="tracker" value="&lt;b&gt;AircraftTracker&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;aircraft_tracker.py&lt;br/&gt;&lt;b&gt;2 Hz Flight Loop:&lt;/b&gt;&lt;br/&gt;• Lee datarefs X-Plane:&lt;br/&gt;  lat/lon/alt/psi/theta/phi&lt;br/&gt;  groundspeed/ias/vs&lt;br/&gt;  on_ground, squawk&lt;br/&gt;• Crea AircraftState object&lt;br/&gt;• AircraftStateStore.update()&lt;br/&gt;  → Redis hash (TTL 1h)&lt;br/&gt;  → InfluxDB batch (20 pts)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="480" y="50" width="210" height="230" as="geometry"/>
        </mxCell>

        <!-- AircraftMover -->
        <mxCell id="mover" value="&lt;b&gt;AircraftMover&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;aircraft_mover.py&lt;br/&gt;&lt;b&gt;10 Hz Flight Loop:&lt;/b&gt;&lt;br/&gt;• Lee Redis move_cmd&lt;br/&gt;• Obtiene posición .obj&lt;br/&gt;• Calcula bearing (Great Circle)&lt;br/&gt;• Calcula distancia a waypoint&lt;br/&gt;• Si &lt;8m: captura waypoint&lt;br/&gt;• xp.instanceSetPosition()&lt;br/&gt;  {x,y,z, pitch, heading, roll}&lt;br/&gt;• Actualiza estado en Redis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="720" y="50" width="220" height="240" as="geometry"/>
        </mxCell>

        <!-- AirportService -->
        <mxCell id="airport-svc" value="&lt;b&gt;AirportService&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;airport_service.py&lt;br/&gt;Lee dataref:&lt;br/&gt;sim/custom/xap/apt/icao&lt;br/&gt;→ ICAO actual del aeropuerto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="30" y="200" width="180" height="100" as="geometry"/>
        </mxCell>

        <!-- StandAssigner -->
        <mxCell id="stand" value="&lt;b&gt;StandAssigner&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;stand_assigner.py&lt;br/&gt;Asigna stands por wingspan&lt;br/&gt;Evita doble reserva&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="240" y="270" width="190" height="80" as="geometry"/>
        </mxCell>

        <!-- AirportDataStore -->
        <mxCell id="airport-ds" value="&lt;b&gt;AirportDataStore&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;airport_data_store.py&lt;br/&gt;Carga AirportGraph desde Redis&lt;br/&gt;data/airport_data/{ICAO}.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="460" y="310" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- FlightPlanService (client) -->
        <mxCell id="fp-client" value="&lt;b&gt;FlightPlanService (client)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;flight_plan_service.py&lt;br/&gt;HTTP GET :8003&lt;br/&gt;/api/v1/flight-plans/{reg}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="wm">
          <mxGeometry x="30" y="360" width="190" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== EXTERNAL: X-Plane SDK API ===== -->
        <mxCell id="xplane-sdk" value="&lt;b&gt;X-Plane SDK (XPPython3 API)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;xp.findDataRef() / getDataf() / getDatavi()&lt;br/&gt;xp.loadObject() / createInstance() / instanceSetPosition()&lt;br/&gt;xp.createFlightLoop() / scheduleFlightLoop()&lt;br/&gt;xp.createProbe() / probeTerrainXYZ()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;arcSize=8;" vertex="1" parent="xplane-proc">
          <mxGeometry x="20" y="870" width="1060" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== EXTERNAL SERVICES ===== -->
        <mxCell id="redis-ext" value="&lt;b&gt;Redis :6379&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Estado + comandos&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="250" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="influx-ext" value="&lt;b&gt;InfluxDB :8087&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Series temporales&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="380" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="hmi-ext" value="&lt;b&gt;HMI Service :8005&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Airport ICAO sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="500" width="150" height="70" as="geometry"/>
        </mxCell>

        <!-- Flechas a servicios externos -->
        <mxCell id="arr-tracker-redis" value="Write state" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="tracker" target="redis-ext" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-tracker-influx" value="Write history" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="tracker" target="influx-ext" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-mover-redis" value="Read move_cmd" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="mover" target="redis-ext" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-loop2s-redis" value="Poll session_request" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="loop-2s" target="redis-ext" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-loop30s-hmi" value="HTTP sync ICAO" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;fontSize=9;" edge="1" source="loop-30s" target="hmi-ext" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Flechas internas -->
        <mxCell id="arr-pi-wm" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;" edge="1" source="pi-entry" target="wm" parent="xppython"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-pi-l30" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;dashed=1;" edge="1" source="pi-entry" target="loop-30s" parent="xppython"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-wm-sdk" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;" edge="1" source="wm" target="xplane-sdk" parent="xplane-proc"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
