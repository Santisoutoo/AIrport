<mxfile host="app.diagrams.net">
  <diagram id="d10-taxi" name="10 — Algoritmo de Enrutamiento Taxi (Airport Graph)">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TÍTULO -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot;&gt;AIrport — Algoritmo de Enrutamiento Taxi (Airport Graph + Dijkstra)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1100" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== PARTE 1: ESTRUCTURA DEL GRAFO ===== -->
        <mxCell id="graph-section" value="&lt;b&gt;Estructura del Grafo del Aeropuerto (NetworkX DiGraph)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="1640" height="380" as="geometry"/>
        </mxCell>

        <!-- AirportGraph -->
        <mxCell id="airport-graph" value="&lt;b&gt;AirportGraph&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;plugins/GND/graph.py&lt;br/&gt;graph: nx.DiGraph (NetworkX)&lt;br/&gt;Construido desde JSON pre-procesado&lt;br/&gt;data/airport_data/{ICAO}/{ICAO}_graph.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;arcSize=8;fontSize=10;" vertex="1" parent="graph-section">
          <mxGeometry x="20" y="50" width="240" height="100" as="geometry"/>
        </mxCell>

        <!-- TaxiNode -->
        <mxCell id="taxi-node" value="&lt;b&gt;TaxiNode (Vértice)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;id : int&lt;br/&gt;lat : float (grados)&lt;br/&gt;lon : float (grados)&lt;br/&gt;type: &quot;stand&quot; | &quot;taxiway&quot; |&lt;br/&gt;       &quot;runway&quot; | &quot;intersection&quot;&lt;br/&gt;name : str (ej. &quot;T1&quot;, &quot;E3&quot;, &quot;25R&quot;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;arcSize=8;fontSize=10;" vertex="1" parent="graph-section">
          <mxGeometry x="300" y="40" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- TaxiEdge -->
        <mxCell id="taxi-edge" value="&lt;b&gt;TaxiEdge (Arista dirigida)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;from_node : int&lt;br/&gt;to_node : int&lt;br/&gt;weight : float (distancia metros)&lt;br/&gt;taxiway_id : str (ej. &quot;T1&quot;)&lt;br/&gt;one_way : bool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;arcSize=8;fontSize=10;" vertex="1" parent="graph-section">
          <mxGeometry x="560" y="40" width="220" height="130" as="geometry"/>
        </mxCell>

        <!-- Stand -->
        <mxCell id="stand-node" value="&lt;b&gt;Stand (Gate/Puesto)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;stand_id : str (ej. &quot;B12&quot;)&lt;br/&gt;lat, lon : float&lt;br/&gt;heading : float (°)&lt;br/&gt;wingspan_max : float (m)&lt;br/&gt;capacity : &quot;A&quot;|&quot;B&quot;|&quot;C&quot;|&quot;D&quot;|&quot;E&quot;|&quot;F&quot;&lt;br/&gt;node_id : int (nodo grafo)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;arcSize=8;fontSize=10;" vertex="1" parent="graph-section">
          <mxGeometry x="820" y="40" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Runway -->
        <mxCell id="runway-node" value="&lt;b&gt;Runway (Pista)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;runway_id : str (ej. &quot;25R&quot;)&lt;br/&gt;threshold_lat, threshold_lon&lt;br/&gt;heading : float (°)&lt;br/&gt;length_m : float&lt;br/&gt;threshold_node_id : int (nodo grafo)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;arcSize=8;fontSize=10;" vertex="1" parent="graph-section">
          <mxGeometry x="1080" y="40" width="220" height="130" as="geometry"/>
        </mxCell>

        <!-- Aeropuertos disponibles -->
        <mxCell id="airports-avail" value="&lt;b&gt;Aeropuertos disponibles:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;• LEBL (Barcelona-El Prat)&lt;br/&gt;• LECO (A Coruña)&lt;br/&gt;• LEST (Santiago de Compostela)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;arcSize=8;fontSize=10;" vertex="1" parent="graph-section">
          <mxGeometry x="1340" y="40" width="250" height="100" as="geometry"/>
        </mxCell>

        <!-- JSON source -->
        <mxCell id="json-src" value="&lt;b&gt;Fuente de datos:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;data/scripts/airport_data_fetcher.py&lt;br/&gt;  → Descarga datos X-Plane&lt;br/&gt;data/scripts/airport_graph_builder.py&lt;br/&gt;  → Parsea a JSON (nodes, edges, stands, runways)&lt;br/&gt;Ficheros: data/airport_data/{ICAO}/{ICAO}_graph.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;arcSize=8;fontSize=10;" vertex="1" parent="graph-section">
          <mxGeometry x="300" y="220" width="860" height="110" as="geometry"/>
        </mxCell>

        <!-- ===== PARTE 2: ALGORITMO DE ENRUTAMIENTO ===== -->
        <mxCell id="algo-section" value="&lt;b&gt;Algoritmo de Enrutamiento — get_taxi_route()&lt;/b&gt;&lt;br/&gt;Ficheros: shared/services/taxi_router.py · services/orchestrator_service/agent/tools/taxi_route.py" style="swimlane;startSize=50;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="490" width="1640" height="660" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="algo-input" value="&lt;b&gt;Parámetros de entrada:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;registration: &quot;N77EM&quot;&lt;br/&gt;destination: &quot;25R&quot; (runway) | &quot;B12&quot; (stand)&lt;br/&gt;via: [&quot;T1&quot;, &quot;E3&quot;] (taxiways opcionales)&lt;br/&gt;icao: &quot;LEBL&quot; (aeropuerto)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="30" y="70" width="270" height="110" as="geometry"/>
        </mxCell>

        <!-- Paso 1: Cargar grafo -->
        <mxCell id="algo-s1" value="&lt;b&gt;1. Cargar grafo del aeropuerto&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;AirportDataStore.get_graph(icao)&lt;br/&gt;Primero busca en Redis: airport:graph&lt;br/&gt;Si no está: carga JSON desde disco&lt;br/&gt;y cachea en Redis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="330" y="70" width="270" height="110" as="geometry"/>
        </mxCell>

        <!-- Paso 2: Identificar nodos -->
        <mxCell id="algo-s2" value="&lt;b&gt;2. Identificar nodos origen/destino&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;Origen: stand asignado al aircraft&lt;br/&gt;  → aircraft_clearances.stand_id&lt;br/&gt;  → AirportGraph.stands[id].node_id&lt;br/&gt;Destino: threshold del runway&lt;br/&gt;  → AirportGraph.runways[id].threshold_node_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="630" y="70" width="270" height="130" as="geometry"/>
        </mxCell>

        <!-- Paso 3: Dijkstra -->
        <mxCell id="algo-s3" value="&lt;b&gt;3. NetworkX Dijkstra&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;nx.shortest_path(G,&lt;br/&gt;  source=origin_node,&lt;br/&gt;  target=dest_node,&lt;br/&gt;  weight=&quot;weight&quot;)&lt;br/&gt;&lt;br/&gt;Peso: distancia en metros&lt;br/&gt;Grafo: DiGraph (dirigido)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#7b1fa2;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="930" y="70" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- Paso 4: Filtrar via -->
        <mxCell id="algo-s4" value="&lt;b&gt;4. Aplicar constraints &quot;via&quot;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;Si via=[&quot;T1&quot;, &quot;E3&quot;]:&lt;br/&gt;Segmenta la ruta en tramos:&lt;br/&gt;  origen → T1 → E3 → destino&lt;br/&gt;Aplica Dijkstra en cada tramo&lt;br/&gt;Concatena los waypoints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="1190" y="70" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- Paso 5: Output -->
        <mxCell id="algo-s5" value="&lt;b&gt;5. Generar respuesta&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;waypoints: [&lt;br/&gt;  {lat: 41.297, lon: 2.083, name: &quot;T1&quot;},&lt;br/&gt;  {lat: 41.296, lon: 2.081, name: &quot;E3&quot;},&lt;br/&gt;  {lat: 41.291, lon: 2.070, name: &quot;25R THR&quot;}&lt;br/&gt;]&lt;br/&gt;total_distance_m: 1250.4&lt;br/&gt;estimated_time_s: 107 (@ 7 kts)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="30" y="250" width="320" height="150" as="geometry"/>
        </mxCell>

        <!-- Redis write -->
        <mxCell id="algo-redis" value="&lt;b&gt;6. Escribir en Redis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;aircraft:{reg}:move_cmd = {&lt;br/&gt;  mode: &quot;waypoints&quot;,&lt;br/&gt;  waypoints: [{lat,lon},...],&lt;br/&gt;  speed_kts: 7.0,&lt;br/&gt;  started_at: &lt;timestamp&gt;&lt;br/&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="380" y="250" width="270" height="150" as="geometry"/>
        </mxCell>

        <!-- X-Plane consumes -->
        <mxCell id="algo-xp" value="&lt;b&gt;7. X-Plane Plugin consume (10 Hz)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;color:#444;&quot;&gt;AircraftMover.loop():&lt;br/&gt;  1. Lee waypoints de Redis&lt;br/&gt;  2. Obtiene posición actual .obj&lt;br/&gt;  3. calc_bearing() → Great Circle&lt;br/&gt;  4. avanza dt·speed hacia waypoint&lt;br/&gt;  5. Si distancia &lt; 8m: next waypoint&lt;br/&gt;  6. xp.instanceSetPosition(x,y,z,h,p,r)&lt;br/&gt;  7. Actualiza Redis con nueva posición&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;arcSize=8;fontSize=10;" vertex="1" parent="algo-section">
          <mxGeometry x="680" y="250" width="290" height="200" as="geometry"/>
        </mxCell>

        <!-- Visualización del grafo (esquema) -->
        <mxCell id="graph-viz" value="&lt;b&gt;Esquema conceptual del grafo (LEBL):&lt;/b&gt;" style="text;html=1;fontSize=11;fontStyle=1;" vertex="1" parent="algo-section">
          <mxGeometry x="1010" y="240" width="280" height="25" as="geometry"/>
        </mxCell>

        <!-- Nodo stand -->
        <mxCell id="viz-stand" value="&lt;b&gt;B12&lt;/b&gt;&lt;br/&gt;Stand" style="ellipse;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=9;" vertex="1" parent="algo-section">
          <mxGeometry x="1020" y="280" width="60" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="viz-t1a" value="T1-A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;" vertex="1" parent="algo-section">
          <mxGeometry x="1120" y="270" width="60" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="viz-t1b" value="T1-B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;" vertex="1" parent="algo-section">
          <mxGeometry x="1220" y="280" width="60" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="viz-e3" value="E3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;" vertex="1" parent="algo-section">
          <mxGeometry x="1320" y="270" width="60" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="viz-rwy" value="&lt;b&gt;25R&lt;/b&gt;&lt;br/&gt;THR" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="algo-section">
          <mxGeometry x="1430" y="275" width="60" height="50" as="geometry"/>
        </mxCell>

        <!-- Aristas del grafo visual -->
        <mxCell id="viz-e1" value="45m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;fontSize=9;" edge="1" source="viz-stand" target="viz-t1a" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="viz-e2" value="120m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;fontSize=9;" edge="1" source="viz-t1a" target="viz-t1b" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="viz-e3-arr" value="95m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;fontSize=9;" edge="1" source="viz-t1b" target="viz-e3" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="viz-e4" value="800m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontSize=9;" edge="1" source="viz-e3" target="viz-rwy" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Ruta óptima label -->
        <mxCell id="viz-optimal" value="&lt;b&gt;Ruta óptima (Dijkstra):&lt;/b&gt;&lt;br/&gt;B12 → T1-A → T1-B → E3 → 25R THR&lt;br/&gt;Distancia total: 1.060 m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;arcSize=8;fontSize=9;" vertex="1" parent="algo-section">
          <mxGeometry x="1020" y="360" width="470" height="65" as="geometry"/>
        </mxCell>

        <!-- Flechas del algoritmo -->
        <mxCell id="arr-in-s1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="algo-input" target="algo-s1" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-s1-s2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="algo-s1" target="algo-s2" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-s2-s3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7b1fa2;" edge="1" source="algo-s2" target="algo-s3" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-s3-s4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="algo-s3" target="algo-s4" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-s4-s5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;" edge="1" source="algo-s4" target="algo-s5" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-s5-redis" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;" edge="1" source="algo-s5" target="algo-redis" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-redis-xp" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;" edge="1" source="algo-redis" target="algo-xp" parent="algo-section"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
