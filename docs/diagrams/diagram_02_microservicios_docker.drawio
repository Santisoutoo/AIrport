<mxfile host="app.diagrams.net">
  <diagram id="d02-docker" name="02 — Microservicios Docker Compose">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TÍTULO -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot;&gt;AIrport — Arquitectura de Microservicios (Docker Compose)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="900" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== DOCKER NETWORK (contenedor externo) ===== -->
        <mxCell id="docker-net" value="&lt;b&gt;Red Docker Interna (airport_network)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f0f8ff;strokeColor=#4a86e8;dashed=1;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="1350" height="720" as="geometry"/>
        </mxCell>

        <!-- ===== INFRAESTRUCTURA ===== -->
        <mxCell id="infra-group" value="&lt;b&gt;Infraestructura (Stateful)&lt;/b&gt;" style="swimlane;startSize=25;fillColor=#fffde7;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="docker-net">
          <mxGeometry x="20" y="50" width="1310" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="redis-c" value="&lt;b&gt;redis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;image: redis:7-alpine&lt;br/&gt;interno: 6379&lt;br/&gt;expuesto: 6379&lt;br/&gt;&lt;br/&gt;Estado en tiempo real&lt;br/&gt;Pub/Sub aeronaves&lt;br/&gt;Comandos movimiento&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="infra-group">
          <mxGeometry x="60" y="35" width="170" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="pg-c" value="&lt;b&gt;postgres&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;image: postgres:15&lt;br/&gt;interno: 5432&lt;br/&gt;expuesto: 5432&lt;br/&gt;&lt;br/&gt;aircraft_clearances&lt;br/&gt;flight_plans&lt;br/&gt;atis&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="infra-group">
          <mxGeometry x="370" y="35" width="170" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="influx-c" value="&lt;b&gt;influxdb&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;image: influxdb:2.7&lt;br/&gt;interno: 8086&lt;br/&gt;expuesto: 8087&lt;br/&gt;&lt;br/&gt;Measurement: aircraft_state&lt;br/&gt;Retention: 1 semana&lt;br/&gt;Tags: session, reg, type&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="infra-group">
          <mxGeometry x="680" y="35" width="170" height="140" as="geometry"/>
        </mxCell>

        <!-- ===== MICROSERVICIOS ===== -->
        <mxCell id="svc-group" value="&lt;b&gt;Microservicios de Aplicación (FastAPI)&lt;/b&gt;" style="swimlane;startSize=25;fillColor=#e8f5e9;strokeColor=#4caf50;fontStyle=1;fontSize=10;" vertex="1" parent="docker-net">
          <mxGeometry x="20" y="270" width="1310" height="430" as="geometry"/>
        </mxCell>

        <!-- ASR Service -->
        <mxCell id="asr-c" value="&lt;b&gt;asr_service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Puerto: 8000&lt;br/&gt;FastAPI&lt;br/&gt;—&lt;br/&gt;Whisper medium.en&lt;br/&gt;fine-tuned ATC&lt;br/&gt;LLM corrector (Gemini)&lt;br/&gt;POST /api/v1/asr/transcribe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=10;" vertex="1" parent="svc-group">
          <mxGeometry x="30" y="50" width="195" height="160" as="geometry"/>
        </mxCell>

        <!-- Flight Plan Service -->
        <mxCell id="fp-c" value="&lt;b&gt;flight_plan_service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Puerto: 8003&lt;br/&gt;FastAPI&lt;br/&gt;—&lt;br/&gt;Genera planes IFR&lt;br/&gt;flightplandatabase.com API&lt;br/&gt;GET/POST /api/v1/flight-plans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=10;" vertex="1" parent="svc-group">
          <mxGeometry x="260" y="50" width="195" height="160" as="geometry"/>
        </mxCell>

        <!-- Weather Service -->
        <mxCell id="weather-c" value="&lt;b&gt;weather_service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Puerto: 8004&lt;br/&gt;FastAPI&lt;br/&gt;—&lt;br/&gt;METAR · TAF · ATIS&lt;br/&gt;Aviation Weather Center&lt;br/&gt;GET /api/v1/weather/atis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=10;" vertex="1" parent="svc-group">
          <mxGeometry x="490" y="50" width="195" height="160" as="geometry"/>
        </mxCell>

        <!-- HMI Service -->
        <mxCell id="hmi-c" value="&lt;b&gt;controller_hmi_service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Puerto: 8005&lt;br/&gt;FastAPI + HTML/JS&lt;br/&gt;—&lt;br/&gt;UI web controlador&lt;br/&gt;Flight strips · Radar suelo&lt;br/&gt;ATIS display&lt;br/&gt;POST /api/v1/hmi/transmit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=10;" vertex="1" parent="svc-group">
          <mxGeometry x="720" y="50" width="195" height="160" as="geometry"/>
        </mxCell>

        <!-- Orchestrator -->
        <mxCell id="orch-c" value="&lt;b&gt;orchestrator_service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Puerto: 8006&lt;br/&gt;FastAPI + Google ADK&lt;br/&gt;—&lt;br/&gt;Enrutamiento DEL/GND/TWR&lt;br/&gt;Estado máquina aeronaves&lt;br/&gt;Tools: taxi, advance, forward&lt;br/&gt;POST /api/v1/dispatch/transmit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;fontSize=10;" vertex="1" parent="svc-group">
          <mxGeometry x="950" y="50" width="195" height="160" as="geometry"/>
        </mxCell>

        <!-- Conexiones servicios a infraestructura -->
        <mxCell id="e-orch-pg2" value="SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="orch-c" target="pg-c" parent="docker-net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-orch-redis2" value="Redis" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="orch-c" target="redis-c" parent="docker-net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-fp-pg2" value="SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="fp-c" target="pg-c" parent="docker-net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-weather-pg2" value="SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;fontSize=9;" edge="1" source="weather-c" target="pg-c" parent="docker-net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Conexiones entre servicios -->
        <mxCell id="e-hmi-asr2" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="hmi-c" target="asr-c" parent="svc-group">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-hmi-orch2" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="hmi-c" target="orch-c" parent="svc-group">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-orch-fp2" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="orch-c" target="fp-c" parent="svc-group">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-orch-weather2" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555;fontSize=9;" edge="1" source="orch-c" target="weather-c" parent="svc-group">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== EXTERNO: X-Plane Plugin ===== -->
        <mxCell id="xplane-ext" value="&lt;b&gt;X-Plane 12 + Plugin&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Proceso externo (no Docker)&lt;br/&gt;XPPython3 in-process&lt;br/&gt;Accede a Redis y HMI via localhost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1420" y="300" width="230" height="100" as="geometry"/>
        </mxCell>

        <!-- X-Plane → Redis -->
        <mxCell id="e-xp-redis3" value="Redis :6379 (localhost)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;dashed=1;fontSize=9;" edge="1" source="xplane-ext" target="redis-c" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- X-Plane → InfluxDB -->
        <mxCell id="e-xp-influx3" value="InfluxDB :8087 (localhost)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;dashed=1;fontSize=9;" edge="1" source="xplane-ext" target="influx-c" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- X-Plane → HMI -->
        <mxCell id="e-xp-hmi3" value="HTTP :8005 (sync ICAO)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;dashed=1;fontSize=9;" edge="1" source="xplane-ext" target="hmi-c" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== EXTERNO: Navegador ===== -->
        <mxCell id="browser-ext" value="&lt;b&gt;Navegador Web&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Controlador ATC&lt;br/&gt;localhost:8005&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1420" y="500" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e-browser-hmi" value="HTTP :8005" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;fontSize=9;" edge="1" source="browser-ext" target="hmi-c" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== EXTERNO: Google Cloud ===== -->
        <mxCell id="gcloud-ext" value="&lt;b&gt;Google Cloud Run&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;DEL / GND / TWR Agents&lt;br/&gt;Gemini Flash (IA)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1420" y="150" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e-orch-gcloud" value="HTTPS (Cloud Run)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;fontSize=9;" edge="1" source="orch-c" target="gcloud-ext" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
