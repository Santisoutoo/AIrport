                <mxCell id="s1" value="&lt;b&gt;1. Habla por micrófono&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Pulsa PTT (Push to Talk)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="lane-ctrl" vertex="1">
