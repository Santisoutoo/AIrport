                <mxCell id="s12" value="&lt;b&gt;12. Respuesta al controlador&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;clearance_text → pantalla&lt;br/&gt;TTS → X-Plane voz piloto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="lane-hmi" vertex="1">
