                <mxCell id="s3" value="&lt;b&gt;3. Transcripción Whisper&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;POST /api/v1/asr/transcribe&lt;br/&gt;Modelo fine-tuned ATC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="lane-asr" vertex="1">
