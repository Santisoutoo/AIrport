# AIrport ATC Simulator - Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# Notes:
# - docker-compose.yml loads this file via `env_file: .env` for every service
#   and also injects some service-to-service URLs directly (REDIS_URL, DB_*,
#   FLIGHT_PLAN_SERVICE_URL, WEATHER_SERVICE_URL...). You normally don't need
#   to set those here.
# - Variables commented out below are optional tunables with sane defaults.

# ============================================
# Vertex AI / Gemini / Cloud Run agents
# ============================================
# Cloud Run URLs of the deployed ATC agents (empty = orchestrator runs without them)
DEL_AGENT_URL=https://del-agent-XXXXXXXX-ew.a.run.app
GND_AGENT_URL=https://gnd-agent-XXXXXXXX-ew.a.run.app
TWR_AGENT_URL=https://twr-agent-XXXXXXXX-ew.a.run.app

# Internal URLs (docker-compose service names; change only for local non-docker runs)
ORCHESTRATOR_URL=http://orchestrator_service:8006
ASR_URL=http://asr_service:8000/api/v1/asr

VERTEX_PROJECT=your-gcp-project
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite

# Credentials for Vertex AI:
# - GCP_SA_KEY_PATH: service-account key file used by deploy scripts
# - GOOGLE_APPLICATION_CREDENTIALS_JSON: inline SA key JSON injected into the
#   asr_service / orchestrator_service containers by docker-compose
GCLOUD_CREDENTIALS_DIR=
GCP_SA_KEY_PATH=./secrets/sa-key.json
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ============================================
# google-genai SDK (Vertex) — used by the LLM-as-judge and local scripts
# ============================================
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
# Application Default Credentials for genai.Client(). Prefer running
# `gcloud auth application-default login` and leaving this unset (the SDK
# finds ADC automatically); otherwise point it at a credentials JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/adc.json

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airport
POSTGRES_USER=airport_user
POSTGRES_PASSWORD=change_me

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# InfluxDB (aircraft state history — shared/services/aircraft_state_store.py)
# ============================================
# Org/bucket are also used by docker-compose to initialize the influxdb container.
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=airport
INFLUXDB_BUCKET=aircraft_state

# ============================================
# Flight Plan generator (flightplandatabase.com)
# ============================================
FLIGHT_PLAN_GENERATOR_KEY=

# ============================================
# ASR Service - HuggingFace ATC fine-tuned Whisper (local inference)
# ============================================
# Pick hf_model from AVAILABLE_MODELS in services/asr_service/core/config.py
ASR_HF_MODEL=jacktol/whisper-medium.en-fine-tuned-for-ATC-faster-whisper
ASR_WHISPER_LANGUAGE=en
ASR_WHISPER_DEVICE=cpu            # "cpu" or "cuda"
ASR_WHISPER_COMPUTE_TYPE=int8     # "int8", "float16", "float32"
ASR_WHISPER_BEAM_SIZE=5
ASR_REQUEST_TIMEOUT=30
ASR_PORT=8000
ASR_LOG_LEVEL=info
ASR_WORKERS=1
# LLM fallback for callsign/SID entity mapping (defaults to GEMINI_MODEL in compose)
# ASR_LLM_MODEL=gemini-3.1-flash-lite
# ASR_LLM_FALLBACK=True

# ============================================
# Arrival Simulator (optional tunables, defaults in code)
# ============================================
# ARRIVAL_INTERVAL_S=120
# ARRIVAL_MIN_CONCURRENT=1
# ARRIVAL_CHECK_INTERVAL_S=10
# ARRIVAL_SLOT_SEP_NM=5
# ARRIVAL_SPAWN_DISTANCE_NM=10
# ARRIVAL_SPAWN_ALT_AGL_FT=3000
# ARRIVAL_IAS_KTS=140
# ARRIVAL_VS_FPM=-700
# ARRIVAL_REQUEST_AT_NM=8
# ARRIVAL_DECEL_KTS_S=2.0
# ARRIVAL_STOP_KTS=15
# ARRIVAL_VACATE_KTS=30

# ============================================
# Agents evaluation (agents_evaluation/, run locally)
# ============================================
# JUDGE_MODEL=gemini-2.5-pro
# JUDGE_AGENT_TIMEOUT_S=60
# VALIDATE_TIMEOUT_S=60
# ASR_BENCH_AUDIO_DIR=./output/asr_bench/audio

# ============================================
# Transcription tool (transcription/, standalone; Ollama or Vertex backend)
# ============================================
# AGENT_MODE=ollama            # "ollama" or "vertex"
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434
# VERTEX_MODEL=gemini-3.1-flash-lite

# ============================================
# Misc (per-service, usually set by docker-compose or deploy scripts)
# ============================================
# LOG_LEVEL=info
# AGENT_MODEL=gemini-3.1-flash-lite   # Cloud Run agents; compose derives it from GEMINI_MODEL
# DEBRIEF_MODEL=gemini-3.1-flash-lite # orchestrator debrief agent (falls back to AGENT_MODEL)
# CORS_ORIGINS=http://localhost:8005  # comma-separated allowed origins; defaults to the local HMI origin
