FROM python:3.11-slim

WORKDIR /app

# System deps: ffmpeg for audio decoding
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Python deps — CUDA build of torch. The cu121 wheels bundle the CUDA
# runtime libs themselves; Cloud Run only needs to inject the GPU driver.
COPY requirements.txt .
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir -r requirements.txt

# Available models:
#   jacktol/whisper-medium.en-fine-tuned-for-ATC-faster-whisper
#   jacktol/whisper-large-v3-finetuned-for-ATC
#   jlvdoorn/whisper-tiny-atco2-asr
#   jlvdoorn/whisper-medium-atco2-asr
#   jlvdoorn/whisper-large-v3-atco2-asr  (default — GPU tier target)
ARG ASR_HF_MODEL=jlvdoorn/whisper-large-v3-atco2-asr
ENV ASR_HF_MODEL=${ASR_HF_MODEL}
ENV ASR_WHISPER_DEVICE=cuda

COPY download_model.py .
RUN python download_model.py

COPY . .

# Cloud Run injects PORT env var; default to 8000
ENV PORT=8000

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT}"]
